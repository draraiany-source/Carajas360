rules_version = '2';
// Carajás 360 — Storage Rules (Fase 1)
// Documentos de verificação de prestadores são privados: não use
// getDownloadURL para publicá-los. O app grava apenas o CAMINHO em
// providers/{uid}/private/verification e o admin gera a URL sob demanda.
service firebase.storage {
  match /b/{bucket}/o {

    function isAuth() { return request.auth != null; }
    // Auditoria: sem SVG (script em caminho público); só formatos raster.
    function isImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|gif|heic)') &&
             request.resource.size < 8 * 1024 * 1024;
    }
    function isDocOrImage() {
      return (request.resource.contentType.matches('image/(jpeg|png|webp|gif|heic)') ||
              request.resource.contentType.matches('application/pdf') ||
              request.resource.contentType.matches('audio/.*')) &&
             request.resource.size < 15 * 1024 * 1024;
    }
    function isAdmin() {
      return isAuth() && (
        request.auth.token.get('admin', false) == true ||
        request.auth.token.get('role', '') == 'admin' ||
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.type == 'admin'
      );
    }
    function isParticipant(roomId) {
      return isAuth() &&
        request.auth.uid in firestore.get(/databases/(default)/documents/chatRooms/$(roomId)).data.participants;
    }

    // Foto de perfil do usuário: pública. Demais arquivos do usuário: privados.
    match /users/{userId}/photo/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAuth() && request.auth.uid == userId && isImage();
      allow delete: if isAuth() && request.auth.uid == userId;
    }
    match /users/{userId}/{allPaths=**} {
      allow read: if isAuth() && (request.auth.uid == userId || isAdmin());
      allow create, update: if isAuth() && request.auth.uid == userId && isImage();
      allow delete: if isAuth() && request.auth.uid == userId;
    }

    // Foto pública do prestador.
    match /providers/{userId}/photo/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAuth() && request.auth.uid == userId && isImage();
      allow delete: if isAuth() && request.auth.uid == userId;
    }

    // Documento, selfie e certificados: somente dono e admin.
    match /providers/{userId}/{docType}/{allPaths=**} {
      allow read: if isAuth() && (request.auth.uid == userId || isAdmin());
      // Auditoria: documento enviado não é substituído (troca pós-aprovação);
      // novo envio vai com outro nome. Dono pode apagar (LGPD).
      allow create: if isAuth() && request.auth.uid == userId && resource == null &&
        docType in ['document', 'selfie', 'certificate'] && isDocOrImage();
      allow delete: if isAuth() && (request.auth.uid == userId || isAdmin());
    }

    // Anexos do questionário Resolve (Fase 4): o cliente envia para a
    // própria pasta; o servidor valida e só libera ao profissional
    // escolhido por URL temporária (getResolveAttachmentUrl).
    match /resolveUploads/{userId}/{allPaths=**} {
      allow read: if isAuth() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuth() && request.auth.uid == userId && resource == null &&
        (request.resource.contentType.matches('image/(jpeg|png|webp|heic)') ||
         request.resource.contentType == 'application/pdf') &&
        request.resource.size < 10 * 1024 * 1024;
      allow update, delete: if false;
    }

    match /orders/{orderId}/{allPaths=**} {
      allow read: if isAuth() && (
        firestore.get(/databases/(default)/documents/orders/$(orderId)).data.clientId
          == request.auth.uid ||
        firestore.get(/databases/(default)/documents/orders/$(orderId)).data.providerId
          == request.auth.uid ||
        isAdmin()
      );
      // Auditoria: sem sobrescrever arquivo da outra parte.
      allow create: if isAuth() && resource == null && isDocOrImage() && (
        firestore.get(/databases/(default)/documents/orders/$(orderId)).data.clientId
          == request.auth.uid ||
        firestore.get(/databases/(default)/documents/orders/$(orderId)).data.providerId
          == request.auth.uid ||
        isAdmin()
      );
    }

    match /stores/{storeId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAuth() && isImage() &&
        firestore.get(/databases/(default)/documents/stores/$(storeId)).data.ownerId == request.auth.uid;
      allow delete: if isAuth() &&
        firestore.get(/databases/(default)/documents/stores/$(storeId)).data.ownerId == request.auth.uid;
    }

    // Fotos de anúncios antigos (somente leitura e remoção pelo dono).
    match /rentals/{rentalId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAuth() && isImage() &&
        firestore.get(/databases/(default)/documents/rentals/$(rentalId)).data.ownerId == request.auth.uid;
      allow delete: if isAuth() &&
        firestore.get(/databases/(default)/documents/rentals/$(rentalId)).data.ownerId == request.auth.uid;
    }

    // Fotos de anúncio de locação: pasta do dono (o anúncio novo ainda
    // não existe quando a foto é enviada).
    match /rentalPhotos/{userId}/{allPaths=**} {
      allow read: if true;
      allow create: if isAuth() && request.auth.uid == userId && resource == null && isImage();
      allow delete: if isAuth() && request.auth.uid == userId;
    }

    match /chat_media/{roomId}/{allPaths=**} {
      allow read: if isParticipant(roomId);
      allow create: if isParticipant(roomId) && resource == null && isDocOrImage();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
