rules_version = '2';
// ════════════════════════════════════════════════════════════════
// Carajás 360 — Firestore Rules (Fase 1: segurança e privacidade)
//
// Princípios:
//  • Dados privados de prestadores ficam em providers/{id}/private/*.
//  • Perfil público de prestador só é listável quando verificado.
//  • Chat: participantes e vínculos imutáveis; sala com id canônico.
//  • Resolve: detalhes/endereço só para cliente, admin e prestador
//    escolhido. Oportunidades e propostas passam por Cloud Functions,
//    que validam a elegibilidade do prestador.
//  • Avaliação: só o cliente do pedido concluído, para o prestador do
//    pedido, uma por contratação.
//  • Notas, verificações, saldos, comissões e permissões: só servidor.
//  • Fase 3: pedidos do Mercado, tentativas de pagamento, reembolsos,
//    razão da carteira e configuração financeira: escrita só servidor.
// ════════════════════════════════════════════════════════════════
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function isOwner(id) { return isAuth() && uid() == id; }
    function isAdminClaim() {
      return isAuth() && (
        request.auth.token.get('admin', false) == true ||
        request.auth.token.get('role', '') == 'admin'
      );
    }
    function isAdmin() {
      return isAdminClaim() ||
        (isAuth() &&
          exists(/databases/$(database)/documents/users/$(uid())) &&
          get(/databases/$(database)/documents/users/$(uid())).data.type == 'admin');
    }
    // Admin "master": claim do Auth ou adminRole master no próprio perfil.
    function isMasterAdmin() {
      return isAdminClaim() ||
        (isAdmin() && get(/databases/$(database)/documents/users/$(uid())).data.get('adminRole', '') == 'master');
    }
    // Modo manutenção (config/platform): usuários comuns não criam pedidos,
    // mensagens, avaliações nem anúncios; administradores continuam.
    function notInMaintenance() {
      return !exists(/databases/$(database)/documents/config/platform) ||
        get(/databases/$(database)/documents/config/platform).data.get('maintenanceMode', false) != true ||
        isAdmin();
    }
    function incoming() { return request.resource.data; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // Campos que nenhum usuário comum pode gravar no próprio perfil.
    function userProtectedKeys() {
      return [
        'type', 'role', 'roles', 'adminRole', 'admin', 'verified', 'active',
        'plan', 'walletId', 'financialStatus', 'permissions', 'createdAt',
        'xp', 'status', 'balance', 'rating', 'totalReviews', 'commissionRate'
      ];
    }
    function profileTypes() { return ['client', 'provider', 'deliverer', 'company']; }

    // Item do catálogo existe e está ativo (incluindo ancestrais).
    // Desativar no admin impede NOVAS contratações; históricos seguem.
    function verifiedProvider(id) {
      return id is string && id.size() > 0 && id.size() <= 128 &&
        exists(/databases/$(database)/documents/providers/$(id)) &&
        get(/databases/$(database)/documents/providers/$(id)).data.get('verified', false) == true &&
        get(/databases/$(database)/documents/providers/$(id)).data.get('active', true) != false;
    }

    function boundedText(v, max) {
      return v is string && v.size() <= max;
    }

    function catalogActive(id) {
      return id is string && id.size() > 0 &&
        exists(/databases/$(database)/documents/catalogNodes/$(id)) &&
        get(/databases/$(database)/documents/catalogNodes/$(id)).data.effectiveActive == true;
    }

    function ownsCompany(companyId) {
      return isAuth() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/companies/$(companyId)) &&
          get(/databases/$(database)/documents/companies/$(companyId)).data.ownerId == uid())
      );
    }

    // ── Usuários (perfil privado: só dono e admin) ────────────────
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) &&
        incoming().type in profileTypes() &&
        !incoming().keys().hasAny([
          'role', 'adminRole', 'admin', 'permissions', 'walletId',
          'financialStatus', 'balance', 'rating', 'totalReviews', 'commissionRate'
        ]) &&
        incoming().get('verified', false) == false &&
        incoming().get('xp', 0) == 0 &&
        incoming().get('status', 'active') == 'active' &&
        incoming().get('plan', 'free') == 'free' &&
        (!('roles' in incoming()) || incoming().roles.hasOnly(profileTypes()));
      // Auditoria: admin comum não muda papéis (type/adminRole) e ninguém
      // muda o próprio papel; só admin master/claim, em outro usuário.
      allow update: if (isAdmin() &&
          (!changed().hasAny(['type', 'adminRole', 'admin', 'role', 'roles']) ||
           (isMasterAdmin() && !isOwner(userId)))) || (
        isOwner(userId) && !changed().hasAny(userProtectedKeys())
      );
      // Auditoria: apagar o próprio doc burlava a suspensão (recriado
      // como 'active'). Exclusão de conta só pelo admin/servidor.
      allow delete: if isAdmin();
    }

    // ── Prestadores: perfil PÚBLICO ───────────────────────────────
    // Documentos de identidade, selfie e certificados NÃO podem estar
    // aqui; ficam em providers/{id}/private/verification.
    function providerPublicEditable() {
      return [
        'name', 'photoUrl', 'bio', 'city', 'state', 'categories',
        'modalities', 'minPrice', 'serviceAreas', 'radiusKm', 'updatedAt',
        // Fase 4: matching (localização aproximada, disponibilidade, pausa).
        'geo', 'availability', 'acceptingRequests', 'unavailableUntil'
      ];
    }
    function providerServerKeys() {
      return ['userId', 'rating', 'totalReviews', 'active', 'verified', 'createdAt'];
    }
    function validProviderShape(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 120 &&
        d.categories is list && d.categories.size() > 0 && d.categories.size() <= 30 &&
        (!('modalities' in d) || d.modalities.hasOnly(['presential', 'online', 'home_care'])) &&
        (!('radiusKm' in d) || d.radiusKm == null || (d.radiusKm is number && d.radiusKm >= 1 && d.radiusKm <= 200)) &&
        (!('geo' in d) || d.geo == null || (d.geo.keys().hasOnly(['lat', 'lng']) &&
          d.geo.lat is number && d.geo.lat >= -90 && d.geo.lat <= 90 &&
          d.geo.lng is number && d.geo.lng >= -180 && d.geo.lng <= 180)) &&
        (!('availability' in d) || d.availability == null || (d.availability.keys().hasOnly(['weekdays', 'periods']) &&
          (!('weekdays' in d.availability) || (d.availability.weekdays is list && d.availability.weekdays.size() <= 7 &&
            d.availability.weekdays.hasOnly([0, 1, 2, 3, 4, 5, 6]))) &&
          (!('periods' in d.availability) || (d.availability.periods is list &&
            d.availability.periods.hasOnly(['morning', 'afternoon', 'evening']))))) &&
        (!('acceptingRequests' in d) || d.acceptingRequests is bool) &&
        (!('unavailableUntil' in d) || d.unavailableUntil == null ||
          (d.unavailableUntil is string && d.unavailableUntil.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')));
    }

    match /providers/{providerId} {
      // Pendentes (não verificados) só são visíveis ao próprio dono e ao admin.
      allow read: if resource.data.verified == true ||
        (isAuth() && resource.data.userId == uid()) ||
        isAdmin();
      allow create: if isOwner(providerId) &&
        incoming().keys().hasOnly(providerPublicEditable().concat(providerServerKeys())) &&
        incoming().userId == uid() &&
        incoming().get('verified', false) == false &&
        incoming().get('active', false) == false &&
        incoming().get('rating', 0) == 0 &&
        incoming().get('totalReviews', 0) == 0 &&
        validProviderShape(incoming());
      allow update: if isAdmin() || (
        isOwner(providerId) &&
        changed().hasOnly(providerPublicEditable().concat(['active'])) &&
        (!changed().hasAny(['active']) || resource.data.verified == true) &&
        validProviderShape(incoming())
      );
      allow delete: if isAdmin();

      // Documentação privada de verificação (somente dono e admin).
      match /private/{docId} {
        allow read: if isOwner(providerId) || isAdmin();
        allow create, update: if isAdmin() || (
          isOwner(providerId) &&
          docId == 'verification' &&
          incoming().keys().hasOnly([
            'documentPath', 'selfiePath', 'certificates', 'certificatePaths',
            'submittedAt', 'updatedAt'
          ]) &&
          (!('certificates' in incoming()) || incoming().certificates.size() <= 20)
        );
        allow delete: if isAdmin();
      }
    }

    match /companies/{companyId} {
      allow read: if true;
      allow create: if isAuth() &&
        incoming().ownerId == uid() &&
        companyId == uid() &&
        incoming().get('active', false) == false &&
        incoming().get('verified', false) == false &&
        incoming().get('plan', 'free') == 'free' &&
        !incoming().keys().hasAny(['rating', 'totalReviews', 'commissionRate', 'searchTokens', 'cityKey']);
      allow update: if isAdmin() || (
        resource.data.ownerId == uid() &&
        !changed().hasAny(['verified', 'plan', 'ownerId', 'active',
          'rating', 'totalReviews', 'commissionRate', 'searchTokens', 'cityKey'])
      );
      allow delete: if isAdmin();
    }

    match /employees/{employeeId} {
      allow read: if isAdmin() ||
        (isAuth() && resource.data.get('userId', '') == uid()) ||
        (isAuth() && ownsCompany(resource.data.companyId));
      allow create: if ownsCompany(request.resource.data.companyId);
      allow update: if ownsCompany(resource.data.companyId) &&
        incoming().companyId == resource.data.companyId;
      allow delete: if ownsCompany(resource.data.companyId);
    }

    match /branches/{branchId} {
      allow read: if true;
      allow create: if ownsCompany(request.resource.data.companyId);
      allow update: if ownsCompany(resource.data.companyId) &&
        incoming().companyId == resource.data.companyId;
      allow delete: if ownsCompany(resource.data.companyId);
    }

    // Contadores públicos nascem zerados (o servidor os mantém).
    function zeroCounters() {
      return incoming().get('rating', 0) == 0 && incoming().get('totalReviews', 0) == 0;
    }

    match /stores/{storeId} {
      allow read: if true;
      allow create: if isAuth() && incoming().ownerId == uid() &&
        zeroCounters() && incoming().get('verified', false) == false &&
        !incoming().keys().hasAny(['commissionRate']) && notInMaintenance();
      allow update: if isAdmin() || (isAuth() &&
        resource.data.ownerId == uid() &&
        !changed().hasAny(['ownerId', 'rating', 'totalReviews', 'verified', 'commissionRate']));
      allow delete: if isAuth() && (resource.data.ownerId == uid() || isAdmin());
    }

    match /products/{productId} {
      allow read: if true;
      // Auditoria: com storeId, a loja TEM de ser do autor (antes, possuir
      // qualquer empresa permitia inserir produto na loja de outra pessoa).
      allow create: if isAuth() && zeroCounters() && notInMaintenance() && (
        isAdmin() ||
        ('storeId' in incoming() && incoming().storeId is string &&
          exists(/databases/$(database)/documents/stores/$(incoming().storeId)) &&
          get(/databases/$(database)/documents/stores/$(incoming().storeId)).data.ownerId == uid()) ||
        (!('storeId' in incoming()) && ownsCompany(incoming().get('companyId', ''))));
      allow update: if isAdmin() || (isAuth() &&
        get(/databases/$(database)/documents/stores/$(resource.data.storeId)).data.ownerId == uid() &&
        !changed().hasAny(['storeId', 'companyId', 'rating', 'totalReviews']));
      allow delete: if isAuth() &&
        (get(/databases/$(database)/documents/stores/$(resource.data.storeId)).data.ownerId == uid() || isAdmin());
    }

    match /rentals/{rentalId} {
      allow read: if true;
      allow create: if isAuth() && incoming().ownerId == uid() &&
        zeroCounters() && incoming().get('verified', false) == false && notInMaintenance();
      allow update: if isAdmin() || (isAuth() &&
        resource.data.ownerId == uid() &&
        !changed().hasAny(['ownerId', 'rating', 'totalReviews', 'verified']));
      allow delete: if isAuth() && (resource.data.ownerId == uid() || isAdmin());
    }

    // Reservas de locação (Fase 5): criação e transições SOMENTE pelas
    // callables createRentalBooking/transitionRentalBooking (preço, total,
    // sobreposição e papéis validados no servidor).
    match /bookings/{bookingId} {
      allow read: if isAuth() &&
        (resource.data.clientId == uid() ||
         resource.data.ownerId == uid() || isAdmin());
      allow write: if false;
    }

    match /contracts/{contractId} {
      allow read: if isAdmin() || ownsCompany(resource.data.companyId);
      allow create: if ownsCompany(request.resource.data.companyId) || isAdmin();
      allow update: if isAdmin() || (ownsCompany(resource.data.companyId) &&
        incoming().companyId == resource.data.companyId);
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAuth() && (
        resource.data.clientId == uid() ||
        resource.data.providerId == uid() ||
        isAdmin()
      );
      allow create: if isAuth()
        && incoming().clientId == uid()
        && incoming().status == 'pending'
        && incoming().get('payoutProcessed', false) == false
        && incoming().get('payoutStatus', 'none') == 'none'
        && incoming().get('paymentStatus', 'unpaid') in ['unpaid', 'pending']
        && !incoming().keys().hasAny([
          // Auditoria: preço vem do orçamento do prestador (accept).
          'price', 'total',
          'commission', 'platformFee', 'providerAmount',
          'transactionId', 'cashbackGranted', 'paidAt', 'payoutAt',
          'reviewed', 'refunded', 'refundAmount', 'serviceSnapshot',
          'financeTerms', 'paidAttemptId'
        ])
        // Fase 3: compras do Mercado só via createMarketOrder (marketOrders),
        // com preço/frete/total calculados no servidor.
        && incoming().get('type', 'service') != 'marketplace'
        // Serviço contratado precisa estar ativo no catálogo.
        && catalogActive(incoming().get('category', ''))
        // Auditoria 2: o pedido avisa o prestador; só prestador verificado e
        // ativo (senão vira canal de mensagens para qualquer usuário).
        && verifiedProvider(incoming().get('providerId', ''))
        && incoming().providerId != uid()
        && boundedText(incoming().get('title', ''), 120)
        && boundedText(incoming().get('description', ''), 2000)
        && notInMaintenance();
      // Cliente/prestador só marcam review. Status/preço/repasse: Cloud Functions.
      allow update: if isAdmin() || (
        isAuth() &&
        resource.data.clientId == uid() &&
        changed().hasOnly(['reviewed']) &&
        exists(/databases/$(database)/documents/reviews/$(orderId + '_' + uid())) &&
        resource.data.status == 'completed' &&
        incoming().reviewed == true
      );
      allow delete: if isAdmin();
    }

    // Perfil público mínimo (Fase 6): nome de exibição, foto e tipo.
    // Mantido só pelo servidor; usado no chat no lugar do perfil privado.
    match /publicProfiles/{userId} {
      allow read: if isAuth();
      allow write: if false;
    }

    // ── Chat ──────────────────────────────────────────────────────
    // Sala 1:1 com id canônico "{uidMenor}_{uidMaior}". Participantes e
    // vínculos (orderId/requestId) são definidos na criação e nunca
    // mudam por usuários comuns.
    match /chatRooms/{roomId} {
      function roomParticipants() {
        return get(/databases/$(database)/documents/chatRooms/$(roomId)).data.participants;
      }
      function validNewRoom() {
        let p = incoming().participants;
        return p is list && p.size() == 2 &&
          p[0] is string && p[1] is string &&
          p[0] < p[1] &&
          roomId == p[0] + '_' + p[1] &&
          uid() in p &&
          incoming().keys().hasOnly(['participants', 'createdAt', 'orderId', 'requestId']) &&
          incoming().createdAt == request.time;
      }
      // get de sala inexistente é permitido (resource == null) para o
      // fluxo "abrir ou criar"; não revela conteúdo algum.
      allow get: if isAuth() && (resource == null || uid() in resource.data.participants);
      allow list: if isAuth() && uid() in resource.data.participants;
      allow create: if isAuth() && validNewRoom();
      allow update: if isAuth() &&
        uid() in resource.data.participants &&
        changed().hasOnly(['lastMsg', 'lastMsgTime', 'typing_' + uid()]) &&
        (!changed().hasAny(['lastMsg']) ||
          (incoming().lastMsg is string && incoming().lastMsg.size() <= 4000));
      allow delete: if isAdmin();

      match /messages/{msgId} {
        allow read: if isAuth() && uid() in roomParticipants();
        allow create: if isAuth() &&
          uid() in roomParticipants() &&
          incoming().senderId == uid() &&
          incoming().keys().hasOnly([
            'senderId', 'senderName', 'text', 'read', 'mediaUrl',
            'replyToText', 'replyToSender', 'createdAt', 'orderId'
          ]) &&
          notInMaintenance() &&
          incoming().read == false &&
          incoming().createdAt == request.time &&
          incoming().text is string && incoming().text.size() <= 4000 &&
          // orderId (mensagem automática da solicitação, sem push): só o
          // cliente do próprio pedido.
          (!('orderId' in incoming()) || (
            incoming().orderId is string && incoming().orderId.size() <= 128 &&
            exists(/databases/$(database)/documents/orders/$(incoming().orderId)) &&
            get(/databases/$(database)/documents/orders/$(incoming().orderId)).data.clientId == uid()));
        allow update: if isAuth() && uid() in roomParticipants() && (
          // Destinatário marca como lida.
          (resource.data.senderId != uid() &&
            changed().hasOnly(['read']) && incoming().read == true) ||
          // Remetente apaga para todos.
          (resource.data.senderId == uid() &&
            changed().hasOnly(['deleted', 'text', 'mediaUrl']) &&
            incoming().deleted == true && incoming().text == '')
        );
        allow delete: if isAdmin();
      }
    }

    match /wallets/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    match /transactions/{txId} {
      allow read: if isAuth() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update, delete: if false;
    }

    match /payments/{paymentId} {
      allow read: if isAuth() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // ── Fase 3: pedidos do Mercado, pagamentos e financeiro ───────
    // Tudo é gravado SOMENTE por Cloud Functions (valores do servidor).
    function isFinanceAdmin() {
      return isAdminClaim() || (isAdmin() &&
        get(/databases/$(database)/documents/users/$(uid())).data.get('adminRole', 'master') in ['master', 'financial']);
    }
    // Carrinho sincronizado (só o dono). Preços aqui são apenas exibição;
    // o pedido recalcula tudo no servidor.
    match /carts/{userId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) &&
        incoming().keys().hasOnly(['items', 'updatedAt']) &&
        incoming().items is list && incoming().items.size() <= 100;
    }
    match /marketOrders/{orderId} {
      allow read: if isAuth() && (
        resource.data.clientId == uid() ||
        resource.data.storeOwnerId == uid() ||
        isFinanceAdmin());
      allow write: if false;
      match /events/{eventId} {
        allow read: if isAuth() && (
          get(/databases/$(database)/documents/marketOrders/$(orderId)).data.clientId == uid() ||
          get(/databases/$(database)/documents/marketOrders/$(orderId)).data.storeOwnerId == uid() ||
          isFinanceAdmin());
        allow write: if false;
      }
    }
    match /paymentAttempts/{attemptId} {
      allow read: if isAuth() && (resource.data.userId == uid() || isFinanceAdmin());
      allow write: if false;
      match /events/{eventId} {
        allow read: if isFinanceAdmin();
        allow write: if false;
      }
    }
    match /walletRecharges/{id} {
      allow read: if isAuth() && (resource.data.userId == uid() || isFinanceAdmin());
      allow write: if false;
    }
    match /earnings/{orderId} {
      allow read: if isAuth() && (resource.data.sellerId == uid() || isFinanceAdmin());
      allow write: if false;
    }
    match /refunds/{id} {
      allow read: if isFinanceAdmin();
      allow write: if false;
    }
    match /financialIssues/{id} {
      allow read: if isFinanceAdmin();
      allow write: if false;
    }
    match /webhookEvents/{id} {
      allow read: if isFinanceAdmin();
      allow write: if false;
    }
    match /reconciliationRuns/{id} {
      allow read: if isFinanceAdmin();
      allow write: if false;
    }

    match /financialAudits/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /rateLimits/{id} {
      allow read, write: if false;
    }

    match /migrations/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /deliveries/{deliveryId} {
      allow read: if isAuth() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        resource.data.delivererId == request.auth.uid ||
        isAdmin()
      );
      // Auditoria: sem fluxo de entrega no servidor, o cliente podia criar
      // entrega com qualquer entregador e posição. Congelado até existir callable.
      allow write: if false;
    }

    // Saúde (Fase 5): agendamento só pelas callables (profissional, data,
    // horário real, consentimento). Dados clínicos em private/clinical:
    // só paciente e profissional (nem admin lê pelo app).
    match /appointments/{appointmentId} {
      allow read: if isAuth() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.providerId == request.auth.uid ||
        isAdmin()
      );
      allow write: if false;
      match /private/{docId} {
        allow read: if isAuth() && (
          resource.data.clientId == uid() || resource.data.providerId == uid());
        allow write: if false;
      }
    }
    // Agenda pública do profissional de saúde (só horários e preços).
    match /healthSchedules/{providerId} {
      allow read: if isAuth();
      allow write: if isOwner(providerId) &&
        exists(/databases/$(database)/documents/providers/$(providerId)) &&
        incoming().keys().hasOnly(['weekly', 'slotMinutes', 'minLeadHours', 'blockedDates', 'services', 'updatedAt']) &&
        (!('weekly' in incoming()) || incoming().weekly is map) &&
        (!('services' in incoming()) || (incoming().services is list && incoming().services.size() <= 30)) &&
        (!('blockedDates' in incoming()) || (incoming().blockedDates is list && incoming().blockedDates.size() <= 366)) &&
        (!('slotMinutes' in incoming()) || incoming().slotMinutes in [15, 20, 30, 45, 60]);
    }
    match /healthCalendars/{providerId} {
      allow read, write: if false;
    }
    match /healthConsents/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /favorites/{favId} {
      // Auditoria: get de favorito ainda inexistente era negado (resource
      // nulo) e quebrava "favoritar". Liberado só no id do próprio usuário.
      allow get: if isAuth() && (resource == null ? favId.matches(uid() + '_.+')
                                                  : resource.data.userId == uid());
      allow list: if isAuth() && resource.data.userId == uid();
      allow create: if isAuth() &&
        incoming().userId == uid() &&
        favId.matches(uid() + '_.+');
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // ── Avaliações ────────────────────────────────────────────────
    // Uma por contratação (id = "{orderId}_{clientId}", só create).
    // A Cloud Function onReviewCreated revalida e recalcula a nota.
    match /reviews/{reviewId} {
      function reviewedOrder() {
        return get(/databases/$(database)/documents/orders/$(incoming().orderId)).data;
      }
      allow read: if true;
      allow create: if isAuth()
        // R22: nome/foto do autor NÃO vêm do app; o servidor preenche a
        // partir do perfil público mínimo de quem está autenticado.
        && incoming().keys().hasOnly([
          'orderId', 'clientId', 'providerId', 'stars', 'comment', 'tags', 'createdAt'
        ])
        && incoming().clientId == uid()
        && incoming().orderId is string
        && incoming().orderId.size() > 0
        && reviewId == incoming().orderId + '_' + uid()
        && incoming().stars is int
        && incoming().stars >= 1
        && incoming().stars <= 5
        && (!('comment' in incoming()) || incoming().comment == null ||
            (incoming().comment is string && incoming().comment.size() <= 1000))
        && (!('tags' in incoming()) || incoming().tags == null ||
            (incoming().tags is list && incoming().tags.size() <= 10))
        && incoming().createdAt == request.time
        && notInMaintenance()
        && exists(/databases/$(database)/documents/orders/$(incoming().orderId))
        && reviewedOrder().clientId == uid()
        && reviewedOrder().status == 'completed'
        && incoming().providerId is string
        && reviewedOrder().providerId == incoming().providerId
        && incoming().providerId != uid();
      allow update, delete: if false;
    }

    match /notifications/{notifId} {
      allow read: if isAuth() && resource.data.userId == uid();
      allow update: if isAuth() && resource.data.userId == uid()
        && changed().hasOnly(['read']);
      allow create, delete: if false;
    }

    match /reports/{reportId} {
      allow create: if isAuth() && request.resource.data.reporterId == uid();
      allow read, update: if isAdmin();
    }

    // Auditoria: a lista pública expunha todos os códigos. Validação de
    // cupom pelo servidor (checkCoupon / quoteMarketOrder).
    match /coupons/{couponId} {
      allow read: if isAdmin();
      // Sem exclusão: pedidos guardam couponId e devolvem o uso ao cupom.
      // Para encerrar um cupom, desative-o (active: false).
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Coleção legada (antes da Fase 2). Congelada: o catálogo vive em
    // catalogNodes. Mantida só para inventário da migração.
    match /categories/{categoryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /support/{ticketId} {
      allow read: if isAdmin() || (isAuth() && resource.data.userId == uid());
      allow create: if isAuth() && request.resource.data.userId == uid() &&
        incoming().keys().hasOnly(['userId', 'userName', 'subject', 'message', 'status', 'priority', 'createdAt']) &&
        incoming().status == 'open' && incoming().priority == 'normal' &&
        incoming().subject is string && incoming().subject.size() <= 200 &&
        incoming().message is string && incoming().message.size() <= 5000;
      allow update: if isAdmin();

      // "Meus chamados": conversa do chamado. Só o autor do chamado e a
      // equipe (admin) leem e escrevem; o papel é conferido.
      match /messages/{msgId} {
        function ticket() { return get(/databases/$(database)/documents/support/$(ticketId)).data; }
        allow read: if isAuth() && (isAdmin() || ticket().userId == uid());
        allow create: if isAuth() &&
          incoming().keys().hasOnly(['authorId', 'authorRole', 'text', 'createdAt']) &&
          incoming().authorId == uid() &&
          incoming().createdAt == request.time &&
          incoming().text is string && incoming().text.size() > 0 && incoming().text.size() <= 5000 &&
          ((incoming().authorRole == 'user' && ticket().userId == uid()) ||
           (incoming().authorRole == 'support' && isAdmin()));
        allow update, delete: if false;
      }
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && incoming().adminId == uid();
      allow update, delete: if false;
    }

    match /config/{doc} {
      allow read: if true;
      // config/finance (comissão, cashback, parcelas...) só pela callable
      // updateFinanceConfig, que valida limites e versiona.
      // config/booking (retenção/limite de reservas) só pela callable
      // updateBookingConfig; config/platform (manutenção, contatos) só master.
      allow write: if isAdmin() && !(doc in ['finance', 'booking']) &&
        (doc != 'platform' || isMasterAdmin());
    }
    match /config/{doc}/history/{version} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── Resolve Carajás ───────────────────────────────────────────
    // Solicitações NÃO são públicas. Prestadores elegíveis consultam
    // oportunidades pela callable listResolveOpportunities (dados
    // resumidos, sem endereço) e enviam propostas pela callable
    // submitResolveProposal (valida aprovação, conta ativa e serviço).
    match /resolveRequests/{id} {
      function req() { return resource.data; }
      allow read: if isAuth() && (
        req().clientId == uid() ||
        req().get('matchedProviderId', '') == uid() ||
        isAdmin()
      );
      // Fase 4: criação e aceite SOMENTE pelas callables createResolveRequest
      // (valida questionário/anexos) e acceptResolveProposal (transacional).
      allow create: if false;
      allow update: if isAdmin() || (
        isAuth() && req().clientId == uid() && req().status == 'open' &&
        changed().hasOnly(['status', 'cancelledAt']) &&
        incoming().status == 'cancelled'
      );
      allow delete: if isAdmin();

      // Endereço e contato: cliente, admin e prestador escolhido.
      match /private/{docId} {
        function parent() {
          return get(/databases/$(database)/documents/resolveRequests/$(id)).data;
        }
        allow read: if isAuth() && (
          parent().clientId == uid() ||
          parent().get('matchedProviderId', '') == uid() ||
          isAdmin()
        );
        // Criado pelo servidor; o cliente só ajusta endereço/contato
        // (anexos são gravados apenas pelo servidor, após validação).
        allow create: if false;
        allow update: if isAuth() &&
          docId == 'details' &&
          parent().clientId == uid() &&
          changed().hasOnly(['address', 'reference', 'phone', 'updatedAt']);
        allow delete: if isAdmin();
      }
    }

    match /resolveProposals/{id} {
      function parentReq() {
        return get(/databases/$(database)/documents/resolveRequests/$(resource.data.requestId)).data;
      }
      allow read: if isAuth() && (
        resource.data.providerId == uid() ||
        resource.data.get('clientId', '') == uid() ||
        isAdmin() ||
        parentReq().clientId == uid()
      );
      // Criação somente pela callable submitResolveProposal.
      allow create: if false;
      // Aceite: só pela callable acceptResolveProposal.
      allow update: if isAdmin() || (
        // Prestador ajusta ou retira a própria proposta enquanto não aceita.
        isAuth() &&
        resource.data.providerId == uid() &&
        resource.data.accepted == false &&
        resource.data.get('status', 'sent') == 'sent' &&
        // Auditoria: preço só pela callable (price e priceCents juntos);
        // editar price aqui descasava o valor exibido do valor aceito.
        changed().hasOnly(['deadlineDays', 'message', 'available', 'updatedAt'])
      );
      allow delete: if isAdmin();
    }

    // Agenda do pedido (Fase 4): criada no aceite, só servidor grava.
    match /scheduleEntries/{orderId} {
      allow read: if isAuth() && (
        resource.data.clientId == uid() || resource.data.providerId == uid() || isAdmin());
      allow write: if false;
    }

    // ── Catálogo (Fase 2) ─────────────────────────────────────────
    // Leitura pública (inclui itens inativos, para exibir históricos).
    // Escrita SOMENTE pelas Cloud Functions de admin (validadas).
    match /catalogNodes/{nodeId} {
      allow read: if true;
      allow write: if false;
    }
    match /catalogMeta/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /catalogMigrations/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // Questionários: publicados são públicos; rascunhos só admin.
    match /serviceQuestionnaires/{qId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
