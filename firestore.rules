rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() { return request.auth != null; }
    function isOwner(uid) { return isAuth() && request.auth.uid == uid; }
    function isAdmin() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.type == 'admin';
    }

    match /users/{userId} {
      // Perfil: leitura autenticada (busca/chat). Escrita pelo dono,
      // sem poder se promover a admin nem alterar campos privilegiados.
      allow read: if isAuth();
      allow create: if isOwner(userId) &&
        request.resource.data.type in ['client', 'provider', 'deliverer', 'company'] &&
        !('adminRole' in request.resource.data.keys());
      allow update: if (isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['type', 'adminRole', 'verified', 'status', 'plan'])) ||
        isAdmin();
      allow delete: if isAdmin();
    }

    match /providers/{providerId} {
      allow read: if true;
      allow write: if isOwner(providerId) || isAdmin();
    }

    match /companies/{companyId} {
      allow read: if true;
      allow create: if isAuth() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isOwner(companyId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Equipe, filiais e contratos (Vol.15: Empresas). Só o dono da
    // empresa (ownerId == uid, verificado via consulta ao documento
    // da empresa) ou admin pode gerenciar.
    match /employees/{employeeId} {
      allow read: if isAuth();
      allow create, update, delete: if isAuth() &&
        (get(/databases/$(database)/documents/companies/$(request.resource.data.companyId)).data.ownerId == request.auth.uid || isAdmin());
    }

    match /branches/{branchId} {
      allow read: if true;
      allow create, update, delete: if isAuth() &&
        (get(/databases/$(database)/documents/companies/$(request.resource.data.companyId)).data.ownerId == request.auth.uid || isAdmin());
    }

    // Marketplace: lojas e produtos. Leitura pública (vitrine);
    // escrita apenas pelo dono da loja ou admin.
    match /stores/{storeId} {
      allow read: if true;
      allow create: if isAuth() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAuth() &&
        (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAuth() &&
        (get(/databases/$(database)/documents/stores/$(request.resource.data.storeId)).data.ownerId == request.auth.uid || isAdmin());
    }

    // Locação: anúncios de veículos e máquinas. Vitrine pública;
    // escrita apenas pelo dono do anúncio ou admin.
    match /rentals/{rentalId} {
      allow read: if true;
      allow create: if isAuth() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAuth() &&
        (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // Reservas de locação: visíveis ao locatário e ao anunciante.
    match /bookings/{bookingId} {
      allow read: if isAuth() &&
        (resource.data.clientId == request.auth.uid ||
         resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isAuth() && request.resource.data.clientId == request.auth.uid;
      allow update: if isAuth() &&
        (resource.data.ownerId == request.auth.uid ||
         resource.data.clientId == request.auth.uid || isAdmin());
    }

    match /contracts/{contractId} {
      allow read: if isAuth();
      allow create, update: if isAuth() &&
        (get(/databases/$(database)/documents/companies/$(request.resource.data.companyId)).data.ownerId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAuth() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.providerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuth() && request.resource.data.clientId == request.auth.uid;
      allow update: if isAuth() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.providerId == request.auth.uid ||
        isAdmin()
      );
    }

    match /chatRooms/{roomId} {
      function roomParticipants() {
        return get(/databases/$(database)/documents/chatRooms/$(roomId)).data.participants;
      }
      allow read: if isAuth() && request.auth.uid in resource.data.participants;
      allow create: if isAuth() &&
        request.auth.uid in request.resource.data.participants;
      allow update: if isAuth() && request.auth.uid in resource.data.participants;

      match /messages/{msgId} {
        allow read: if isAuth() && request.auth.uid in roomParticipants();
        allow create: if isAuth() &&
          request.resource.data.senderId == request.auth.uid &&
          request.auth.uid in roomParticipants();
        allow update: if isAuth() && request.auth.uid in roomParticipants() && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) &&
            resource.data.senderId != request.auth.uid) ||
          (resource.data.senderId == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['deleted', 'text', 'mediaUrl']))
        );
      }
    }

    // Carteira / extrato: SOMENTE Admin SDK (Cloud Functions).
    // O client NÃO pode alterar saldo nem fabricar lançamentos.
    match /wallets/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    match /transactions/{txId} {
      allow read: if isAuth() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update, delete: if false;
    }

    // Pagamentos (PIX/cartão) — escrito pelas Cloud Functions.
    match /payments/{paymentId} {
      allow read: if isAuth() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // GPS entregas: só participantes (cliente / motorista / entregador).
    match /deliveries/{deliveryId} {
      allow read: if isAuth() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        resource.data.delivererId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuth() &&
        request.resource.data.clientId == request.auth.uid;
      allow update: if isAuth() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        resource.data.delivererId == request.auth.uid ||
        isAdmin()
      );
    }

    // Agendamentos Saúde: só cliente ou profissional do agendamento.
    match /appointments/{appointmentId} {
      allow read: if isAuth() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.providerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuth() &&
        request.resource.data.clientId == request.auth.uid;
      allow update: if isAuth() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.providerId == request.auth.uid ||
        isAdmin()
      );
    }

    // Favoritos de prestador e produto (Vol.3/Vol.12 — ver
    // FS.toggleFavorite/toggleProductFavorite). Documento identificado
    // por "{uid}_{targetId}", só o dono pode gerenciar os próprios.
    match /favorites/{favId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // Review só do cliente do pedido concluído (anti fake-review).
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuth()
        && request.resource.data.clientId == request.auth.uid
        && request.resource.data.orderId is string
        && request.resource.data.orderId.size() > 0
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1
        && request.resource.data.stars <= 5
        && exists(/databases/$(database)/documents/orders/$(request.resource.data.orderId))
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.clientId
             == request.auth.uid
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.status
             == 'completed';
      allow update, delete: if false;
    }

    // Notificações: client só lê/marca como lida; criação via Functions.
    match /notifications/{notifId} {
      allow read, update: if isAuth() && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create: if false;
    }

    // Denúncias (Vol.20: Administração). Qualquer usuário autenticado
    // pode denunciar; só o admin pode ler a fila e atualizar status —
    // o denunciante não deve conseguir ver o andamento da moderação.
    match /reports/{reportId} {
      allow create: if isAuth() && request.resource.data.reporterId == request.auth.uid;
      allow read, update: if isAdmin();
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /support/{ticketId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // Configurações da plataforma (Vol.20: Administração). Leitura
    // pública porque qualquer tela pode precisar checar modo de
    // manutenção ou dados de suporte; só o admin escreve.
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Resolve Carajás — pedidos abertos e propostas.
    match /resolveRequests/{id} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.clientId == request.auth.uid;
      // Cliente gerencia o próprio pedido; prestador autenticado pode
      // apenas incrementar proposalCount (envio de proposta).
      allow update: if isAuth() && (
        resource.data.clientId == request.auth.uid ||
        isAdmin() ||
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['proposalCount']) &&
          request.resource.data.proposalCount ==
            resource.data.proposalCount + 1
        )
      );
      allow delete: if isAdmin();
    }

    match /resolveProposals/{id} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.providerId == request.auth.uid;
      allow update: if isAuth() && (
        resource.data.providerId == request.auth.uid ||
        get(/databases/$(database)/documents/resolveRequests/$(resource.data.requestId)).data.clientId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
