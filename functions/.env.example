# Functions env (NÃO commitar valores reais)
# Copie para .env.<projeto> local ou configure no Secret Manager.
# Fase 3: SOMENTE homologação/sandbox. Produção permanece bloqueada.

# Gateway: vazio = pagamentos desligados | fake = simulador (só emulador)
# | mercadopago = sandbox (exige TODAS as condições abaixo).
PAYMENTS_GATEWAY=
# Obrigatório "sandbox" para o gateway mercadopago ligar.
PAYMENTS_ENV=sandbox
# Projetos onde operações reais ficam bloqueadas (vírgula).
PROD_PROJECT_IDS=servicoconecta
# URL pública da function paymentsWebhook do projeto de homologação.
PAYMENTS_WEBHOOK_URL=
# Conta recebedora esperada (valida webhooks); opcional.
MP_COLLECTOR_ID=
# true só quando o token APP_USR- pertence a um USUÁRIO DE TESTE do MP.
MP_TEST_USER_CREDENTIALS=false
MP_WEBHOOK_TOLERANCE_SECONDS=900

# Obrigar App Check nas callables (deixe false até configurar o App Check).
ENFORCE_APP_CHECK=false

# Secrets — nunca no Git (Secret Manager):
# MERCADOPAGO_ACCESS_TOKEN=TEST-...   (credencial de teste)
# MP_WEBHOOK_SECRET=                   (assinatura secreta do webhook, painel MP)
# ANTHROPIC_API_KEY=
