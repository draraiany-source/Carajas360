# Functions env (NÃO commitar valores reais)
# Copie para functions/.env local ou configure no Secret Manager.

# false = staging (padrão). NÃO ligar true sem autorização.
PAYMENTS_ENABLED=false

# FASE 6: cobranca REAL de producao. Manter false ate autorizacao explicita.
# Mesmo com PAYMENTS_ENABLED=true, token APP_USR- e bloqueado se isto for false.
PRODUCTION_PAYMENTS_ENABLED=false

# Obrigar App Check nas callables. Deixe false até Play Integrity / DeviceCheck /
# reCAPTCHA estarem registrados (CHECKLIST_FIREBASE_STAGING.md).
ENFORCE_APP_CHECK=false

# Secrets (NUNCA colar valores aqui no Git):
# firebase functions:secrets:set MERCADOPAGO_ACCESS_TOKEN
# firebase functions:secrets:set ANTHROPIC_API_KEY
# firebase functions:secrets:set MERCADOPAGO_WEBHOOK_SECRET
# firebase functions:secrets:set GOOGLE_MAPS_SERVER_KEY
# Staging: token Mercado Pago TEST- (sandbox) somente.
# Producao: token APP_USR- somente com PRODUCTION_PAYMENTS_ENABLED=true (fora deste repo).
# GOOGLE_MAPS_SERVER_KEY: so a proprietaria cria (restrita por IP da Function).
# Sem ela, getDirections recusa — nao inventar.
